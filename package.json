{
  "name": "app-movilidad-urbana",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "node server.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "node server.js",
    "android:generate": "node scripts/generate-twa.js",
    "android:build": "cd android-twa && .\\gradlew.bat assembleRelease && copy .\\app\\build\\outputs\\apk\\release\\app-release.apk ..\\RielAR-v1.0.0.apk",
    "android:bundle": "cd android-twa && .\\gradlew.bat bundleRelease && copy .\\app\\build\\outputs\\bundle\\release\\app-release.aab ..\\RielAR-v1.0.0.aab"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.25.0",
    "@bubblewrap/core": "^1.25.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
