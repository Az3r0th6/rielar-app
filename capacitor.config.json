{
  "appId": "com.rielar.app",
  "appName": "RielAR",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_name",
      "iconColor": "#009FE3",
      "sound": "beep.wav"
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0A0A0C",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0C",
      "overlaysWebView": false
    }
  }
}
