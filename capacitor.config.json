{
  "appId": "com.rielar.app",
  "appName": "RielAR",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "rielar-app.onrender.com",
      "*.onrender.com"
    ]
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_notification_icon",
      "iconColor": "#009FE3"
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0A0A0C",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0C",
      "overlaysWebView": false
    }
  }
}
